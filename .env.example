# GitHub OAuth App 配置
# Homepage URL: https://清凤.fun
# Callback URL: https://sandbox.清凤.fun/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT 签名密钥（openssl rand -hex 32）
JWT_SECRET=

# 博客域名（GitHub Pages，用于 CORS 和 OAuth 后的 redirect）
BLOG_ORIGIN=https://清凤.fun

# 可选：只允许特定 GitHub 用户使用 sandbox（留空则所有 GitHub 用户均可）
ALLOWED_GITHUB_LOGINS=

# 自定义容器镜像
SANDBOX_IMAGE=chiffon-sandbox:latest

# ── Astro 前端（在 chiffon-Blog 根目录的 .env 里配置）──
# sandbox server 的公开地址，博客在 GitHub Pages 时填 sandbox server 的完整域名
PUBLIC_SANDBOX_API=https://sandbox.清凤.fun
