# Cloudflare 代理开启后，入站请求来自 CF 节点 IP。
# 将 CF 的 IP 段声明为可信代理，Caddy 才能从 X-Forwarded-For 中还原真实客户端 IP，
# 日志、限流等功能才能正常工作。
{
    servers {
        trusted_proxies static \
            173.245.48.0/20 \
            103.21.244.0/22 \
            103.22.200.0/22 \
            103.31.4.0/22 \
            141.101.64.0/18 \
            108.162.192.0/18 \
            190.93.240.0/20 \
            188.114.96.0/20 \
            197.234.240.0/22 \
            198.41.128.0/17 \
            162.158.0.0/15 \
            104.16.0.0/13 \
            104.24.0.0/14 \
            172.64.0.0/13 \
            131.0.72.0/22
    }
}

sandbox.清凤.fun {
    reverse_proxy sandbox-server:3001 {
        # 将 Cloudflare 传来的真实客户端 IP 转发给后端
        header_up X-Real-IP {http.request.header.CF-Connecting-IP}
        header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
    }

    # WebSocket 需要的 header 升级 caddy 自动处理
}
