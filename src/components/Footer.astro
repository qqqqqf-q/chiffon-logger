  <div class="mx-auto max-w-5xl px-6 py-8 flex items-center justify-between">
    <span class="text-fade text-sm">&copy; {year} 清凤</span>
    <a
      href="https://github.com/qqqqqf-q"
      target="_blank"
      rel="noopener noreferrer"
      class="text-fade text-sm hover:text-dim transition-colors"
    >
      GitHub
    </a>
  </div>
</footer>
