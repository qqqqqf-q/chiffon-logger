---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Giscus from '../components/Giscus.astro';

const projects = [
  {
    name: "Arkloop",
    desc: "开源对话式 AI Agent 构建平台，LLM 驱动的智能体运行时。",
    tags: "Agent · LLM · 开源平台",
    link: "https://github.com/qqqqqf-q/Arkloop",
  },
  {
    name: "MirrorFlow",
    desc: "用 C2C 聊天记录微调大模型，还原你的表达风格。",
    tags: "LLM · 微调 · 数字分身",
    link: "https://github.com/qqqqqf-q/MirrorFlow",
  },
  {
    name: "NanoTrans",
    desc: "跨平台极致轻量输入翻译助手，即时翻译与原地回填。",
    tags: "Windows · macOS · 翻译",
    link: "https://github.com/qqqqqf-q/NanoTrans",
  },
  {
    name: "Oxidarb",
    desc: "基于 Rust 的自动三角套利程序，10.0µs 单次循环。",
    tags: "Rust · 量化 · 套利",
    link: "https://github.com/Arkilo-Labs/Oxidarb",
  },
  {
    name: "Arkanis",
    desc: "Arkanis-AI 驱动的交易决策实验系统",
    tags: "Agent · 交易 · 新闻",
    link: "https://github.com/Arkilo-Labs/Arkanis"
  }
];
---

<BaseLayout title="关于" description="关于清凤和这个小站">
  <Header />

  <main class="mx-auto max-w-5xl px-6 py-16">
    <div class="max-w-2xl">

      <div class="flex items-center gap-6 mb-10">
        <img
          src="https://avatars.githubusercontent.com/u/104579013?v=4"
          alt="清凤"
          class="w-20 h-20 rounded-full border border-line"
        />
        <div>
          <h1 class="text-head text-2xl font-semibold mb-1">清凤 kilock</h1>
        </div>
      </div>

      <div class="prose">
        <p>
          这里记录了<strong>清凤</strong>和<strong>kilock</strong>和的日常与点滴，偶尔发发技术Blog
        </p>
        <p>
          两名学生/全栈开发者
        </p>
      </div>

      <div class="mt-8 flex flex-wrap gap-4">
        <a href="https://github.com/qqqqqf-q" target="_blank" rel="noopener noreferrer" class="text-dim text-sm hover:text-head transition-colors duration-normal ease-out">GitHub</a>
        <a href="https://x.com/qqqqqf_" target="_blank" rel="noopener noreferrer" class="text-dim text-sm hover:text-head transition-colors duration-normal ease-out">X</a>
        <a href="https://t.me/NS_qingf_bot" target="_blank" rel="noopener noreferrer" class="text-dim text-sm hover:text-head transition-colors duration-normal ease-out">Telegram</a>
        <a href="https://www.nodeseek.com/space/21917#/general" target="_blank" rel="noopener noreferrer" class="text-dim text-sm hover:text-head transition-colors duration-normal ease-out">NodeSeek</a>
        <a href="mailto:qingf622@outlook.com" class="text-dim text-sm hover:text-head transition-colors duration-normal ease-out">Email</a>
      </div>

      <div class="mt-12 pt-8 border-t border-line">
        <h2 class="text-head text-lg font-semibold mb-4">开源项目</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          {projects.map((p) => (
            <a
              href={p.link}
              target="_blank"
              rel="noopener noreferrer"
              class="p-4 bg-card border border-line rounded-row hover:border-line-soft transition-colors duration-normal ease-out"
            >
              <h3 class="text-head text-sm font-semibold mb-1">{p.name}</h3>
              <p class="text-dim text-xs leading-relaxed mb-2">{p.desc}</p>
              <p class="text-fade text-xs">{p.tags}</p>
            </a>
          ))}
        </div>
        <p class="text-dim text-sm mt-4">欢迎提 issue / PR，也非常欢迎找我一起开发，我很闲</p>
      </div>

      <div class="mt-10 pt-6 border-t border-line text-fade text-xs flex justify-between">
        <span>由 Kilock 提供技术支持</span>
        <span>建站于 2025-08-03</span>
      </div>

      <Giscus />

    </div>
  </main>

  <Footer />
</BaseLayout>
