---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArticleCard from '../components/ArticleCard.astro';

const posts = (await getCollection('journal', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="日志" description="Just Do It  --With World">
  <Header />

  <main class="mx-auto max-w-5xl px-6 py-16">
    <header class="mb-14">
      <h1 class="text-head text-3xl font-semibold tracking-tight mb-3">清凤日志</h1>
      <p class="text-dim text-base max-w-xl">
        Just Do It  --With World
      </p>
    </header>

    {posts.length === 0 ? (
      <p class="text-fade text-sm">还没有文章。</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        {posts.map((post) => (
          <ArticleCard
            slug={post.slug}
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            tags={post.data.tags}
            categories={post.data.categories}
          />
        ))}
      </div>
    )}
  </main>

  <Footer />
</BaseLayout>
