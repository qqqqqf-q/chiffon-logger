#!/usr/bin/env python3
"""
彩蛋：虚假的黑客动画。
"""
import time
import random
import sys
import os
import signal

CHARS = (
    'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz'
    '0123456789@#$%^&*()[]{}<>|;:.,!?/\\~`+-='
)

GREEN  = '\033[32m'
YELLOW = '\033[33m'
RED    = '\033[31m'
BOLD   = '\033[1m'
RESET  = '\033[0m'
CLEAR  = '\033[2J\033[H'

def get_cols():
    try:
        return os.get_terminal_size().columns
    except OSError:
        return 80

def rain(cols, iterations):
    for _ in range(iterations):
        line = ''.join(random.choice(CHARS) for _ in range(cols))
        sys.stdout.write(GREEN + line + '\n')
        sys.stdout.flush()
        time.sleep(0.02)

def print_slow(text, delay=0.04):
    for ch in text:
        sys.stdout.write(ch)
        sys.stdout.flush()
        time.sleep(delay)
    sys.stdout.write('\n')

def main():
    signal.signal(signal.SIGINT, lambda *_: (sys.stdout.write(RESET + '\n'), sys.exit(0)))

    cols = get_cols()
    sys.stdout.write(CLEAR)
    rain(cols, cols // 2)

    time.sleep(0.3)
    sys.stdout.write(RESET + '\n')

    print_slow(f'{RED}{BOLD}[!] INTRUSION DETECTED{RESET}', 0.05)
    time.sleep(0.4)
    print_slow(f'{YELLOW}[*] Tracing source... 127.0.0.1{RESET}', 0.04)
    time.sleep(0.3)
    print_slow(f'{YELLOW}[*] Kernel version: {RESET}', 0.04)

    try:
        with open('/proc/version') as f:
            ver = f.read().strip()[:80]
        print_slow(f'    {ver}', 0.02)
    except OSError:
        print_slow('    unknown', 0.02)

    time.sleep(0.5)
    print_slow(f'{RED}{BOLD}[!] ACCESS DENIED{RESET}', 0.06)
    time.sleep(0.3)
    print_slow(f'\n{GREEN}This is a gVisor sandbox.{RESET}', 0.04)
    print_slow(f'{GREEN}Nice try. The kernel above is real.{RESET}', 0.04)
    print_slow(f'{GREEN}You\'re not getting out.{RESET}\n', 0.04)

if __name__ == '__main__':
    main()
